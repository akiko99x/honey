DATABASE_URL=postgres://honey:change-me@127.0.0.1:5432/honey
# Keep the newest N backup artifacts. To enable encryption, import a public GPG
# key into the honey account's keyring and set its fingerprint or recipient.
HONEY_BACKUP_KEEP=14
# HONEY_BACKUP_GPG_RECIPIENT=backup@example.com
# GNUPGHOME=/var/lib/honey/.gnupg
# Optional legacy machine token. Prefer an admin account + HttpOnly session for
# the browser; keep this unset unless an integration still needs Bearer auth.
# HONEY_API_TOKEN=replace-with-64-random-hex-characters
# 32-byte base64 key for encrypting VPN secrets at rest — generate with:
#   honey-master keygen
# keep it OUT of the database and back it up; losing it makes secrets unrecoverable.
HONEY_SECRET_KEY=generate-with-honey-master-keygen
HONEY_CERTS_DIR=/etc/honey/certs
HONEY_API_LISTEN=127.0.0.1:8080
HONEY_DIAL_LISTEN=0.0.0.0:9443
# GitHub repository used by Settings -> Software update.
HONEY_UPDATE_REPO=akiko99x/honey
# built-in https for the api/panel (build with --features tls). point these at a
# cert issued by certbot/acme.sh; renewals are hot-reloaded. bind the api to a
# public host:port when using TLS, e.g. HONEY_API_LISTEN=0.0.0.0:8443
# HONEY_TLS_CERT=/etc/honey/tls/fullchain.pem
# HONEY_TLS_KEY=/etc/honey/tls/privkey.pem
# alternatively, built-in ACME (build with --features acme; needs :443 reachable,
# so only for a master on its own domain, not a single-server box with REALITY):
#   honey-master run --api-listen 0.0.0.0:443 --acme-domain panel.example.com --acme-email you@example.com
# HONEY_ACME_EMAIL=you@example.com
# HONEY_ACME_CACHE=/var/lib/honey/acme
RUST_LOG=info
